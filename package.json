{
  "name": "quickwashhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:tidb:backup": "node scripts/migrate-postgres-to-tidb.mjs",
    "db:tidb:migrate": "node scripts/migrate-postgres-to-tidb-mysql.mjs",
    "db:tidb:verify": "node scripts/migrate-postgres-to-tidb-mysql.mjs --verify",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.1.0",
    "mariadb": "^3.5.5",
    "pg": "^8.23.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
