NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://carwash:carwash_dev@localhost:5432/carwash?schema=public
AUTH_TOKEN_SECRET=replace_with_a_unique_random_value_at_least_32_characters
DB_POOL_MAX=10

# Add the local origin to Google OAuth authorized JavaScript origins.
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# Email verification and password-reset emails.
RESEND_API_KEY=
EMAIL_FROM=QuickWashHub <support@example.com>
PUBLIC_APP_URL=http://localhost:4000
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_WHATSAPP=8260586748

# Rotated PostgreSQL-compatible TiDB URL. Fill in an actual database name; never commit credentials.
TIDB_DATABASE_URL=

# Cashfree sandbox by default. Never expose the secret in browser code.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_EASY_SPLIT_ENABLED=false
CASHFREE_FEE_PCT=2
PUBLIC_BOOKINGS_ENABLED=false

# Restrict these to the exact zone IDs that cover the approved 42 Mouza pilot.
# Production exposes no pilot zones and paid bookings remain disabled until this list is set.
PILOT_ZONE_IDS=

# Private S3/R2 compatible photo storage.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quickwashhub-private
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio_change_me
S3_FORCE_PATH_STYLE=true

# Local development only. Production must use exact HTTPS website origins.
CORS_ORIGIN=http://localhost:4000
TRUST_PROXY=false
HOME_WASH_ENABLED=false

# Browser push (generate VAPID keys once; keep the private key in deployment secrets).
VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Evolution Go operational WhatsApp alerts; use the instance token, not the global manager key.
EVOLUTION_GO_BASE_URL=
EVOLUTION_GO_INSTANCE_TOKEN=

# Promotional WhatsApp requires an approved template sender/provider.
WHATSAPP_MARKETING_SEND_URL=
WHATSAPP_MARKETING_TOKEN=
WHATSAPP_MARKETING_TEMPLATE=quickwashhub_coupon_offer

# Production launch gates. Complete these only after real approval/onboarding.
LEGAL_REVIEW_APPROVED=false
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
GRIEVANCE_OFFICER=
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=
INITIAL_ADMIN_EMAIL=
